<Window x:Class="SonosDesktopBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SonosDesktopBridge"
        Title="Sonos Desktop Bridge" Height="820" Width="460"
        MinHeight="660" MinWidth="400" Background="{StaticResource Page}"
        Foreground="{StaticResource TextMain}" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" Icon="app.ico">
  <Window.Resources>
    <Style x:Key="Desc" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,3,0,0"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextMuted}"/><Setter Property="Margin" Value="2,24,0,8"/>
    </Style>
    <Style x:Key="Sep" TargetType="Border"><Setter Property="Height" Value="1"/><Setter Property="Background" Value="#2A2A2D"/></Style>
    <Style x:Key="WizTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="WizHelp" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,10,0,18"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

    <!-- Header -->
    <DockPanel Grid.Row="0" Margin="22,22,22,0">
      <Border DockPanel.Dock="Right" Background="{StaticResource Panel}" CornerRadius="16" Padding="11,6" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#D5A85C" Margin="0,0,7,0"/>
          <TextBlock x:Name="StatusText" Text="…" FontSize="12" Foreground="{StaticResource TextMuted}"/>
        </StackPanel>
      </Border>
      <Image Source="logo.png" Width="44" Height="44" DockPanel.Dock="Left" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Sonos Desktop Bridge" FontSize="21" FontWeight="Bold"/>
        <TextBlock Text="{l:L app.tagline}" FontSize="12" Foreground="{StaticResource TextMuted}"/>
      </StackPanel>
    </DockPanel>

    <!-- Tabs -->
    <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="22" Margin="22,18,22,0" Padding="4">
      <UniformGrid Rows="1">
        <RadioButton x:Name="TabHome" Style="{StaticResource TabButton}" Content="{l:L tab.home}" GroupName="tabs" Tag="home" IsChecked="True" Checked="Tab_Checked"/>
        <RadioButton x:Name="TabRooms" Style="{StaticResource TabButton}" Content="{l:L tab.rooms}" GroupName="tabs" Tag="rooms" Checked="Tab_Checked"/>
        <RadioButton x:Name="TabSettings" Style="{StaticResource TabButton}" Content="{l:L tab.settings}" GroupName="tabs" Tag="settings" Checked="Tab_Checked"/>
      </UniformGrid>
    </Border>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <Grid Margin="22,0,22,22">

        <!-- ============ HOME ============ -->
        <StackPanel x:Name="HomeTab">
          <Border Background="{StaticResource Panel}" CornerRadius="22" Padding="18,14" Margin="0,18,0,0">
            <DockPanel>
              <Ellipse x:Name="KeysDot" Width="12" Height="12" Fill="#D5A85C" DockPanel.Dock="Left" Margin="0,0,14,0"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="KeysStatusText" Text="{l:L keys.title}" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock x:Name="KeysStatusSub" Text="" Style="{StaticResource Desc}"/>
              </StackPanel>
            </DockPanel>
          </Border>

          <TextBlock Text="{l:L sec.room}" Style="{StaticResource SectionTitle}"/>
          <Border Background="{StaticResource Panel}" CornerRadius="22" Padding="16">
            <StackPanel>
              <DockPanel>
                <Button Content="{l:L btn.search}" Padding="14,10" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Margin="10,0,0,0" Click="Scan_Click"/>
                <ComboBox x:Name="DevicePicker" Height="44" DisplayMemberPath="Name" SelectionChanged="DevicePicker_SelectionChanged"/>
              </DockPanel>
              <TextBlock x:Name="SourceText" Text="" FontSize="13" FontWeight="SemiBold" Margin="4,12,0,0" TextWrapping="Wrap"/>
              <TextBlock x:Name="DeviceHint" Text="{l:L hint.searching}" Style="{StaticResource Desc}" FontSize="12" Margin="4,4,0,0"/>
            </StackPanel>
          </Border>

          <TextBlock Text="{l:L sec.volume}" Style="{StaticResource SectionTitle}"/>
          <Border Background="{StaticResource Panel}" CornerRadius="22" Padding="22,20,22,18">
            <StackPanel>
              <DockPanel>
                <Button x:Name="MuteButton" Content="{l:L btn.mute}" DockPanel.Dock="Right" VerticalAlignment="Center" Click="Mute_Click"/>
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="VolumeValue" Text="—" FontSize="64" FontWeight="Light" LineHeight="64"/>
                  <TextBlock Text="%" FontSize="20" Foreground="{StaticResource TextMuted}" VerticalAlignment="Bottom" Margin="4,0,0,12"/>
                </StackPanel>
              </DockPanel>
              <DockPanel Margin="0,20,0,0">
                <Button Tag="down" Content="–" Style="{StaticResource RoundButton}" DockPanel.Dock="Left" Click="Step_Click"/>
                <Button Tag="up" Content="+" Style="{StaticResource RoundButton}" DockPanel.Dock="Right" Click="Step_Click"/>
                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="0" IsEnabled="False" Margin="14,0" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
              </DockPanel>
              <Button Content="{l:L btn.refresh}" HorizontalAlignment="Center" Margin="0,16,0,0" Padding="16,8" FontSize="12" Click="Refresh_Click"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ============ ROOMS ============ -->
        <StackPanel x:Name="RoomsTab" Visibility="Collapsed">
          <TextBlock Text="{l:L sec.roomvol}" Style="{StaticResource SectionTitle}" Margin="2,18,0,8"/>
          <Border Background="{StaticResource Panel}" CornerRadius="22" Padding="22,10,22,12">
            <StackPanel>
              <StackPanel x:Name="RoomVolumePanel"/>
              <TextBlock x:Name="RoomVolumeHint" Text="{l:L roomvol.hint}" Style="{StaticResource Desc}" FontSize="12" Margin="0,8"/>
            </StackPanel>
          </Border>

          <TextBlock Text="{l:L sec.link}" Style="{StaticResource SectionTitle}"/>
          <Border Background="{StaticResource Panel}" CornerRadius="22" Padding="20,6">
            <StackPanel>
              <StackPanel x:Name="GroupPanel"/>
              <TextBlock x:Name="GroupHint" Text="{l:L link.none}" Style="{StaticResource Desc}" FontSize="12" Margin="0,14"/>
            </StackPanel>
          </Border>
          <TextBlock Text="{l:L link.note}" Style="{StaticResource Desc}" Margin="6,12,6,0"/>
        </StackPanel>

        <!-- ============ SETTINGS ============ -->
        <StackPanel x:Name="SettingsTab" Visibility="Collapsed">
          <TextBlock Text="{l:L sec.output}" Style="{StaticResource SectionTitle}" Margin="2,18,0,8"/>
          <Border Background="{StaticResource Panel}" CornerRadius="22" Padding="16">
            <StackPanel>
              <ComboBox x:Name="OutputPicker" Height="44" DisplayMemberPath="Name" DropDownOpened="OutputPicker_DropDownOpened" SelectionChanged="OutputPicker_SelectionChanged"/>
              <TextBlock x:Name="OutputHint" Text="" Style="{StaticResource Desc}" FontSize="12" Margin="4,12,0,0"/>
            </StackPanel>
          </Border>

          <TextBlock Text="{l:L sec.keys}" Style="{StaticResource SectionTitle}"/>
          <Border Background="{StaticResource Panel}" CornerRadius="22" Padding="20,6">
            <StackPanel>
              <CheckBox x:Name="InterceptBox" IsChecked="True" Margin="0,14" Checked="Options_Changed" Unchecked="Options_Changed">
                <StackPanel>
                  <TextBlock Text="{l:L opt.intercept}"/>
                  <TextBlock Text="{l:L opt.intercept.d}" Style="{StaticResource Desc}"/>
                </StackPanel>
              </CheckBox>
              <Border Style="{StaticResource Sep}"/>
              <DockPanel Margin="0,10">
                <ComboBox x:Name="StepPicker" Width="86" Height="36" DockPanel.Dock="Right" SelectionChanged="Options_Changed">
                  <ComboBoxItem Content="1 %"/><ComboBoxItem Content="2 %"/><ComboBoxItem Content="3 %"/><ComboBoxItem Content="4 %"/><ComboBoxItem Content="5 %"/>
                </ComboBox>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{l:L opt.step}"/>
                  <TextBlock Text="{l:L opt.step.d}" Style="{StaticResource Desc}"/>
                </StackPanel>
              </DockPanel>
              <Border Style="{StaticResource Sep}"/>
              <DockPanel Margin="0,10">
                <ComboBox x:Name="MaxPicker" Width="140" Height="36" DockPanel.Dock="Right" SelectionChanged="Options_Changed">
                  <ComboBoxItem Content="{l:L max.none}"/><ComboBoxItem Content="90 %"/><ComboBoxItem Content="80 %"/><ComboBoxItem Content="70 %"/>
                  <ComboBoxItem Content="60 %"/><ComboBoxItem Content="50 %"/><ComboBoxItem Content="40 %"/>
                </ComboBox>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{l:L opt.max}"/>
                  <TextBlock Text="{l:L opt.max.d}" Style="{StaticResource Desc}"/>
                </StackPanel>
              </DockPanel>
              <Border Style="{StaticResource Sep}"/>
              <CheckBox x:Name="OnlyLineInBox" Margin="0,14" Checked="Options_Changed" Unchecked="Options_Changed">
                <StackPanel>
                  <TextBlock Text="{l:L opt.linein}"/>
                  <TextBlock Text="{l:L opt.linein.d}" Style="{StaticResource Desc}"/>
                </StackPanel>
              </CheckBox>
              <Border Style="{StaticResource Sep}"/>
              <CheckBox x:Name="MediaBox" IsChecked="True" Margin="0,14" Checked="Options_Changed" Unchecked="Options_Changed">
                <StackPanel>
                  <TextBlock Text="{l:L opt.media}"/>
                  <TextBlock Text="{l:L opt.media.d}" Style="{StaticResource Desc}"/>
                </StackPanel>
              </CheckBox>
            </StackPanel>
          </Border>

          <TextBlock Text="{l:L sec.power}" Style="{StaticResource SectionTitle}"/>
          <Border Background="{StaticResource Panel}" CornerRadius="22" Padding="20,6">
            <StackPanel>
              <DockPanel Margin="0,10">
                <ComboBox x:Name="SleepPicker" Width="140" Height="36" DockPanel.Dock="Right" VerticalAlignment="Top" SelectionChanged="Options_Changed">
                  <ComboBoxItem Content="{l:L sleep.none}"/><ComboBoxItem Content="{l:L sleep.mute}"/>
                </ComboBox>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Text="{l:L opt.sleep}"/>
                  <TextBlock Text="{l:L opt.sleep.d}" Style="{StaticResource Desc}"/>
                </StackPanel>
              </DockPanel>
              <Border Style="{StaticResource Sep}"/>
              <DockPanel Margin="0,10">
                <ComboBox x:Name="DefVolPicker" Width="140" Height="36" DockPanel.Dock="Right" VerticalAlignment="Top" SelectionChanged="Options_Changed">
                  <ComboBoxItem Content="{l:L defvol.none}"/><ComboBoxItem Content="5 %"/><ComboBoxItem Content="10 %"/><ComboBoxItem Content="15 %"/>
                  <ComboBoxItem Content="20 %"/><ComboBoxItem Content="25 %"/><ComboBoxItem Content="30 %"/><ComboBoxItem Content="40 %"/><ComboBoxItem Content="50 %"/>
                </ComboBox>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Text="{l:L opt.defvol}"/>
                  <TextBlock Text="{l:L opt.defvol.d}" Style="{StaticResource Desc}"/>
                </StackPanel>
              </DockPanel>
            </StackPanel>
          </Border>

          <TextBlock Text="{l:L sec.display}" Style="{StaticResource SectionTitle}"/>
          <Border Background="{StaticResource Panel}" CornerRadius="22" Padding="20,6">
            <StackPanel>
              <CheckBox x:Name="OsdBox" IsChecked="True" Margin="0,14" Checked="Options_Changed" Unchecked="Options_Changed">
                <StackPanel>
                  <TextBlock Text="{l:L opt.osd}"/>
                  <TextBlock Text="{l:L opt.osd.d}" Style="{StaticResource Desc}"/>
                </StackPanel>
              </CheckBox>
              <Border Style="{StaticResource Sep}"/>
              <CheckBox x:Name="LockRoomBox" IsChecked="True" Margin="0,14" Checked="Options_Changed" Unchecked="Options_Changed">
                <StackPanel>
                  <TextBlock Text="{l:L opt.lockroom}"/>
                  <TextBlock Text="{l:L opt.lockroom.d}" Style="{StaticResource Desc}"/>
                </StackPanel>
              </CheckBox>
              <Border Style="{StaticResource Sep}"/>
              <CheckBox x:Name="LockOutputBox" IsChecked="True" Margin="0,14" Checked="Options_Changed" Unchecked="Options_Changed">
                <StackPanel>
                  <TextBlock Text="{l:L opt.lockout}"/>
                  <TextBlock Text="{l:L opt.lockout.d}" Style="{StaticResource Desc}"/>
                </StackPanel>
              </CheckBox>
            </StackPanel>
          </Border>

          <TextBlock Text="{l:L sec.app}" Style="{StaticResource SectionTitle}"/>
          <Border Background="{StaticResource Panel}" CornerRadius="22" Padding="20,6">
            <StackPanel>
              <CheckBox x:Name="AutostartBox" Margin="0,14" Checked="Options_Changed" Unchecked="Options_Changed">
                <StackPanel>
                  <TextBlock Text="{l:L opt.autostart}"/>
                  <TextBlock Text="{l:L opt.autostart.d}" Style="{StaticResource Desc}"/>
                </StackPanel>
              </CheckBox>
              <Border Style="{StaticResource Sep}"/>
              <DockPanel Margin="0,10">
                <ComboBox x:Name="LangPicker" Width="140" Height="36" DockPanel.Dock="Right" VerticalAlignment="Top" SelectionChanged="Options_Changed">
                  <ComboBoxItem Content="{l:L lang.auto}"/><ComboBoxItem Content="{l:L lang.fr}"/><ComboBoxItem Content="{l:L lang.en}"/>
                </ComboBox>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Text="{l:L opt.lang}"/>
                  <TextBlock Text="{l:L opt.lang.d}" Style="{StaticResource Desc}"/>
                </StackPanel>
              </DockPanel>
              <Border Style="{StaticResource Sep}"/>
              <StackPanel Margin="0,14">
                <TextBlock x:Name="InstallText" Style="{StaticResource Desc}" FontSize="12" Margin="0"/>
                <WrapPanel Margin="0,12,0,0">
                  <Button x:Name="InstallButton" Content="{l:L btn.install}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,8" Click="Install_Click"/>
                  <Button x:Name="UninstallButton" Content="{l:L btn.uninstall}" Margin="0,0,10,8" Click="Uninstall_Click"/>
                  <Button Content="{l:L btn.replay}" Margin="0,0,0,8" Click="RestartSetup_Click"/>
                </WrapPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <TextBlock x:Name="AboutText" Style="{StaticResource Desc}" Margin="6,16,6,0">
            <Run x:Name="AboutVersion" Text="Version"/><Run Text="{l:L about.text}"/><Hyperlink NavigateUri="https://github.com/eprysmn/sonos-desktop-bridge" RequestNavigate="Link_Navigate" Foreground="White">GitHub</Hyperlink>
          </TextBlock>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <!-- ============ SETUP WIZARD ============ -->
    <Grid x:Name="Wizard" Grid.RowSpan="3" Background="{StaticResource Page}" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

      <Button x:Name="WizardSkip" Content="{l:L w.skip}" Panel.ZIndex="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,24,0" Padding="14,7" FontSize="12" Click="WizardSkip_Click"/>

      <Grid Grid.Row="0" Margin="30,64,30,10">
        <!-- 0 · welcome -->
        <StackPanel x:Name="StepWelcome">
          <Border Width="96" Height="96" CornerRadius="24" BorderBrush="#3A3A3D" BorderThickness="1" HorizontalAlignment="Left" ClipToBounds="True">
            <Image Source="logo.png" Margin="1" RenderOptions.BitmapScalingMode="HighQuality"/>
          </Border>
          <TextBlock Text="{l:L w.welcome}" Style="{StaticResource WizTitle}" Margin="0,26,0,0"/>
          <TextBlock Text="{l:L w.welcome.sub}" Style="{StaticResource WizHelp}" FontSize="16"/>
          <DockPanel Margin="0,8,0,0"><TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}" Width="30" VerticalAlignment="Top" Margin="0,3,0,0"/><TextBlock Text="{l:L w.b1}" TextWrapping="Wrap" FontSize="14"/></DockPanel>
          <DockPanel Margin="0,14,0,0"><TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}" Width="30" VerticalAlignment="Top" Margin="0,3,0,0"/><TextBlock Text="{l:L w.b2}" TextWrapping="Wrap" FontSize="14"/></DockPanel>
          <DockPanel Margin="0,14,0,0"><TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}" Width="30" VerticalAlignment="Top" Margin="0,3,0,0"/><TextBlock Text="{l:L w.b3}" TextWrapping="Wrap" FontSize="14"/></DockPanel>
          <TextBlock Text="{l:L w.steps}" Style="{StaticResource WizHelp}" FontSize="12" Margin="0,30,0,0"/>
        </StackPanel>

        <!-- 1 · room -->
        <DockPanel x:Name="StepRoom" Visibility="Collapsed">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{l:L w.room.t}" Style="{StaticResource WizTitle}"/>
            <TextBlock Text="{l:L w.room.h}" Style="{StaticResource WizHelp}"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <TextBlock x:Name="WizRoomHint" Style="{StaticResource Desc}" FontSize="12" Margin="2,0,0,10"/>
            <Button Content="{l:L w.rescan}" HorizontalAlignment="Left" Padding="16,8" FontSize="12" Click="Scan_Click"/>
          </StackPanel>
          <ListBox x:Name="WizRooms" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource ChoiceItem}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="WizRooms_SelectionChanged">
            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <!-- 2 · output -->
        <DockPanel x:Name="StepOutput" Visibility="Collapsed">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{l:L w.out.t}" Style="{StaticResource WizTitle}"/>
            <TextBlock Text="{l:L w.out.h}" Style="{StaticResource WizHelp}"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <TextBlock x:Name="WizOutputHint" Style="{StaticResource Desc}" FontSize="12" Margin="2,0,0,10"/>
            <Button x:Name="WizUseCurrent" Content="{l:L w.usecurrent}" HorizontalAlignment="Left" Padding="16,8" FontSize="12" Click="WizUseCurrent_Click"/>
          </StackPanel>
          <ListBox x:Name="WizOutputs" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource ChoiceItem}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="WizOutputs_SelectionChanged">
            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <!-- 3 · preferences -->
        <StackPanel x:Name="StepPrefs" Visibility="Collapsed">
          <TextBlock Text="{l:L w.prefs.t}" Style="{StaticResource WizTitle}"/>
          <TextBlock Text="{l:L w.prefs.h}" Style="{StaticResource WizHelp}"/>
          <Border Background="{StaticResource Panel}" CornerRadius="22" Padding="20,6">
            <StackPanel>
              <CheckBox x:Name="WizAutostart" IsChecked="True" Margin="0,14">
                <StackPanel>
                  <TextBlock Text="{l:L opt.autostart}"/>
                  <TextBlock Text="{l:L opt.autostart.d}" Style="{StaticResource Desc}"/>
                </StackPanel>
              </CheckBox>
              <Border Style="{StaticResource Sep}"/>
              <CheckBox x:Name="WizOsd" IsChecked="True" Margin="0,14">
                <StackPanel>
                  <TextBlock Text="{l:L opt.osd}"/>
                  <TextBlock Text="{l:L opt.osd.d}" Style="{StaticResource Desc}"/>
                </StackPanel>
              </CheckBox>
              <Border Style="{StaticResource Sep}"/>
              <CheckBox x:Name="WizLock" IsChecked="True" Margin="0,14">
                <StackPanel>
                  <TextBlock Text="{l:L w.lock}"/>
                  <TextBlock Text="{l:L w.lock.d}" Style="{StaticResource Desc}"/>
                </StackPanel>
              </CheckBox>
              <Border x:Name="WizInstallSep" Style="{StaticResource Sep}"/>
              <CheckBox x:Name="WizInstall" IsChecked="True" Margin="0,14">
                <StackPanel>
                  <TextBlock Text="{l:L w.install}"/>
                  <TextBlock Text="{l:L w.install.d}" Style="{StaticResource Desc}"/>
                </StackPanel>
              </CheckBox>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- 4 · done -->
        <StackPanel x:Name="StepDone" Visibility="Collapsed">
          <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="40" Foreground="{StaticResource Accent}"/>
          <TextBlock Text="{l:L w.done.t}" Style="{StaticResource WizTitle}" Margin="0,18,0,0"/>
          <Border Background="{StaticResource Panel}" CornerRadius="22" Padding="20,16" Margin="0,18,0,18">
            <TextBlock x:Name="WizSummary" FontSize="14" LineHeight="26" TextWrapping="Wrap"/>
          </Border>
          <TextBlock Text="{l:L w.done.try}" FontSize="14" TextWrapping="Wrap"/>
          <TextBlock Text="{l:L w.done.tray}" Style="{StaticResource WizHelp}" FontSize="13" Margin="0,14,0,0"/>
        </StackPanel>
      </Grid>

      <DockPanel Grid.Row="1" Margin="30,0,30,28">
        <Button x:Name="WizardNext" Content="{l:L w.start}" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Padding="26,12" Click="WizardNext_Click"/>
        <Button x:Name="WizardBack" Content="{l:L w.back}" DockPanel.Dock="Left" Padding="20,12" Click="WizardBack_Click"/>
        <StackPanel x:Name="WizardDots" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </DockPanel>
    </Grid>
  </Grid>
</Window>
