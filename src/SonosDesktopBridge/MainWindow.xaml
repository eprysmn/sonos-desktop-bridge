<Window x:Class="SonosDesktopBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sonos Desktop Bridge" Height="820" Width="460"
        MinHeight="660" MinWidth="380" Background="{StaticResource Page}"
        Foreground="{StaticResource TextMain}" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" Icon="app.ico">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="22,26,22,22">

      <!-- Header -->
      <DockPanel>
        <Border DockPanel.Dock="Right" Background="{StaticResource Panel}" CornerRadius="16" Padding="11,6" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#D5A85C" Margin="0,0,7,0"/>
            <TextBlock x:Name="StatusText" Text="Non connecté" FontSize="12" Foreground="{StaticResource TextMuted}"/>
          </StackPanel>
        </Border>
        <TextBlock Text="Volume" FontSize="32" FontWeight="Bold" VerticalAlignment="Center"/>
      </DockPanel>

      <!-- Room -->
      <TextBlock Text="Pièce" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="2,26,0,8"/>
      <Border Background="{StaticResource Panel}" CornerRadius="22" Padding="16">
        <StackPanel>
          <DockPanel>
            <Button Content="Rechercher" Padding="14,10" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Margin="10,0,0,0" Click="Scan_Click"/>
            <ComboBox x:Name="DevicePicker" Height="44" DisplayMemberPath="Name" SelectionChanged="DevicePicker_SelectionChanged"/>
          </DockPanel>
          <TextBlock x:Name="SourceText" Text="" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" Margin="4,12,0,0" TextWrapping="Wrap"/>
          <TextBlock x:Name="DeviceHint" Text="Recherche des lecteurs Sonos sur le réseau local…" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="4,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- Volume -->
      <Border Background="{StaticResource Panel}" CornerRadius="22" Padding="22,24,22,22" Margin="0,14,0,0">
        <StackPanel>
          <DockPanel>
            <Button x:Name="MuteButton" Content="Muet" DockPanel.Dock="Right" VerticalAlignment="Center" Click="Mute_Click"/>
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="VolumeValue" Text="—" FontSize="64" FontWeight="Light" LineHeight="64"/>
              <TextBlock Text="%" FontSize="20" Foreground="{StaticResource TextMuted}" VerticalAlignment="Bottom" Margin="4,0,0,12"/>
            </StackPanel>
          </DockPanel>
          <DockPanel Margin="0,20,0,0">
            <Button Tag="down" Content="–" Style="{StaticResource RoundButton}" DockPanel.Dock="Left" Click="Step_Click"/>
            <Button Tag="up" Content="+" Style="{StaticResource RoundButton}" DockPanel.Dock="Right" Click="Step_Click"/>
            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="0" IsEnabled="False" Margin="14,0" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
          </DockPanel>
          <Button Content="Actualiser" DockPanel.Dock="Right" HorizontalAlignment="Center" Margin="0,18,0,0" Padding="16,8" FontSize="12" Click="Refresh_Click"/>
        </StackPanel>
      </Border>

      <!-- Per-room volume -->
      <TextBlock Text="Volume par pièce" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="2,24,0,8"/>
      <Border Background="{StaticResource Panel}" CornerRadius="22" Padding="22,10,22,12">
        <StackPanel>
          <StackPanel x:Name="RoomVolumePanel"/>
          <TextBlock x:Name="RoomVolumeHint" Text="Lie une autre pièce ci-dessous pour régler leurs volumes séparément." FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,8" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- Linked rooms -->      <TextBlock Text="Lier des pièces" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="2,24,0,8"/>
      <Border Background="{StaticResource Panel}" CornerRadius="22" Padding="20,6">
        <StackPanel>
          <StackPanel x:Name="GroupPanel"/>
          <TextBlock x:Name="GroupHint" Text="Aucune autre pièce détectée." FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,14" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- Windows output -->
      <TextBlock Text="Sortie Windows" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="2,24,0,8"/>
      <Border Background="{StaticResource Panel}" CornerRadius="22" Padding="16">
        <StackPanel>
          <ComboBox x:Name="OutputPicker" Height="44" DisplayMemberPath="Name" DropDownOpened="OutputPicker_DropDownOpened" SelectionChanged="OutputPicker_SelectionChanged"/>
          <TextBlock x:Name="OutputHint" Text="" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="4,12,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- Options -->
      <TextBlock Text="Réglages" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="2,24,0,8"/>
      <Border Background="{StaticResource Panel}" CornerRadius="22" Padding="20,6">
        <StackPanel>
          <CheckBox x:Name="InterceptBox" Content="Touches de volume du clavier" IsChecked="True" Margin="0,14" Checked="Options_Changed" Unchecked="Options_Changed"/>
          <Border Height="1" Background="#2A2A2D"/>
          <DockPanel Margin="0,10">
            <ComboBox x:Name="StepPicker" Width="86" Height="36" DockPanel.Dock="Right" SelectionChanged="Options_Changed">
              <ComboBoxItem Content="1 %"/><ComboBoxItem Content="2 %"/><ComboBoxItem Content="3 %"/><ComboBoxItem Content="4 %"/><ComboBoxItem Content="5 %"/>
            </ComboBox>
            <TextBlock Text="Pas par appui" FontSize="13" VerticalAlignment="Center"/>
          </DockPanel>
          <Border Height="1" Background="#2A2A2D"/>
          <Border Height="1" Background="#2A2A2D"/>
          <CheckBox x:Name="OnlyLineInBox" Content="Seulement si Sonos est sur l'entrée source locale" Margin="0,14" Checked="Options_Changed" Unchecked="Options_Changed"/>
          <Border Height="1" Background="#2A2A2D"/>
          <CheckBox x:Name="OsdBox" Content="Indicateur de volume à l'écran" IsChecked="True" Margin="0,14" Checked="Options_Changed" Unchecked="Options_Changed"/>
          <Border Height="1" Background="#2A2A2D"/>
          <CheckBox x:Name="AutostartBox" Content="Démarrer avec Windows" Margin="0,14" Checked="Options_Changed" Unchecked="Options_Changed"/>
        </StackPanel>
      </Border>

      <!-- Application -->
      <TextBlock Text="Application" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="2,24,0,8"/>
      <Border Background="{StaticResource Panel}" CornerRadius="22" Padding="20,16">
        <StackPanel>
          <TextBlock x:Name="InstallText" FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
          <Button x:Name="InstallButton" Content="Installer dans Windows" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="Install_Click"/>
          <Button x:Name="UninstallButton" Content="Désinstaller" HorizontalAlignment="Left" Margin="0,12,0,0" Click="Uninstall_Click"/>
        </StackPanel>
      </Border>

      <TextBlock Text="Quand la sortie Windows choisie est active, le programme la garde à 100 %. Sur une autre sortie (casque Bluetooth…), les touches reviennent à Windows. Fermer la fenêtre laisse le programme actif dans la zone de notification. Contrôle local, aucun compte requis."
                 FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="6,16,6,0"/>
    </StackPanel>
  </ScrollViewer>
</Window>


